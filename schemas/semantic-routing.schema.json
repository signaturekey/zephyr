{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyr.local/schemas/v1/semantic-routing.schema.json",
  "title": "Zephyr semantic routing decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "decisions"],
  "properties": {
    "version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/nonEmptyString" },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "code-reviewer",
        "architect-reviewer",
        "golang-expert",
        "typescript-expert",
        "frontend-expert",
        "skill-authoring-expert",
        "reliability-expert",
        "messaging-expert",
        "infrastructure-expert",
        "storage-expert",
        "security-auditor",
        "sql-expert",
        "contract-reviewer",
        "qa-expert",
        "code-simplifier"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "decision", "evidence_refs", "reason", "confidence"],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "decision": { "type": "string", "enum": ["include", "exclude"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
