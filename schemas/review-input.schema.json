{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyr.local/schemas/v1/review-input.schema.json",
  "title": "Zephyr immutable review packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "mode",
    "source",
    "repository",
    "changed_files",
    "technologies",
    "diff",
    "business_context",
    "project_instructions",
    "sources",
    "routing_signals",
    "strong_routing_signals",
    "coverage_limits",
    "restrictions"
  ],
  "properties": {
    "version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/nonEmptyString" },
    "mode": {
      "type": "string",
      "enum": ["plan", "implementation", "alignment", "auto"]
    },
    "source": {
      "type": "string",
      "enum": ["working-tree", "staged", "branch", "commit-range", "plan-only"]
    },
    "repository": { "$ref": "#/$defs/repository" },
    "git_metadata": { "type": "object" },
    "changed_files": { "$ref": "#/$defs/stringArray" },
    "technologies": { "$ref": "#/$defs/stringArray" },
    "diff": { "$ref": "#/$defs/diff" },
    "plan": { "$ref": "#/$defs/plan" },
    "business_context": {
      "type": "array",
      "items": { "$ref": "#/$defs/businessContext" }
    },
    "project_instructions": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectInstruction" }
    },
    "sources": { "$ref": "#/$defs/sources" },
    "routing_signals": { "$ref": "#/$defs/stringArray" },
    "strong_routing_signals": { "$ref": "#/$defs/stringArray" },
    "coverage_limits": { "$ref": "#/$defs/stringArray" },
    "restrictions": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string" },
        "branch": { "type": "string" },
        "head": { "type": "string" },
        "base_ref": { "type": "string" },
        "base_sha": { "type": "string" },
        "target_sha": { "type": "string" },
        "merge_base": { "type": "string" },
        "commit_range": { "type": "string" }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truncated", "total_bytes"],
      "properties": {
        "full": { "type": "string" },
        "staged": { "type": "string" },
        "unstaged": { "type": "string" },
        "truncated": { "type": "boolean" },
        "total_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "content_hash", "content", "truncated"],
      "properties": {
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "content_hash": { "$ref": "#/$defs/nonEmptyString" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "content": { "type": "string" },
        "truncated": { "type": "boolean" }
      }
    },
    "businessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fetched_at", "content_hash", "content"],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "key": { "type": "string" },
        "url": { "type": "string" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "content_hash": { "$ref": "#/$defs/nonEmptyString" },
        "content": { "type": "string" }
      }
    },
    "projectInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "content_hash", "content", "truncated"],
      "properties": {
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "content_hash": { "$ref": "#/$defs/nonEmptyString" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "content": { "type": "string" },
        "truncated": { "type": "boolean" }
      }
    },
    "sourceProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reason"],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "unavailable"],
      "properties": {
        "included": { "$ref": "#/$defs/stringArray" },
        "excluded": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceProblem" }
        },
        "unavailable": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceProblem" }
        }
      }
    }
  }
}
