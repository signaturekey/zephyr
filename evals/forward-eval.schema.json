{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyr.local/evals/v1/forward-eval.schema.json",
  "title": "Zephyr forward evaluation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "case_id", "synthetic", "baseline", "zephyr_run", "comparison"],
  "properties": {
    "version": {"const": 1},
    "case_id": {"$ref": "#/$defs/slug"},
    "synthetic": {"type": "boolean"},
    "baseline": {"$ref": "#/$defs/baseline"},
    "zephyr_run": {"$ref": "#/$defs/zephyrRun"},
    "comparison": {"$ref": "#/$defs/comparison"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S"},
    "slug": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "unrated"]},
    "humanFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "category", "summary", "path", "line"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "severity": {"$ref": "#/$defs/severity"},
        "category": {"$ref": "#/$defs/slug"},
        "summary": {"$ref": "#/$defs/nonEmpty"},
        "path": {"type": ["string", "null"], "maxLength": 4096},
        "line": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "zephyrFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "category", "title", "path", "line"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "severity": {"$ref": "#/$defs/severity"},
        "category": {"$ref": "#/$defs/slug"},
        "title": {"$ref": "#/$defs/nonEmpty"},
        "path": {"type": ["string", "null"], "maxLength": 4096},
        "line": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pull_request_ref", "merged_at", "reviewed_sha", "human_findings"],
      "properties": {
        "repository": {"$ref": "#/$defs/nonEmpty"},
        "pull_request_ref": {"$ref": "#/$defs/nonEmpty"},
        "merged_at": {"type": "string", "format": "date-time"},
        "reviewed_sha": {"$ref": "#/$defs/sha"},
        "human_findings": {"type": "array", "items": {"$ref": "#/$defs/humanFinding"}}
      }
    },
    "zephyrRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "mode", "executed_at", "run_id", "review_artifact", "coverage_limits", "findings"],
      "properties": {
        "harness": {"type": "string", "enum": ["codex-app"]},
        "mode": {"type": "string", "enum": ["plan", "implementation", "alignment"]},
        "executed_at": {"type": "string", "format": "date-time"},
        "run_id": {"$ref": "#/$defs/nonEmpty"},
        "review_artifact": {"$ref": "#/$defs/nonEmpty"},
        "coverage_limits": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/zephyrFinding"}}
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_id", "zephyr_ids", "notes"],
      "properties": {
        "human_id": {"$ref": "#/$defs/slug"},
        "zephyr_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}},
        "notes": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "zephyrOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zephyr_id", "disposition", "notes"],
      "properties": {
        "zephyr_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "disposition": {"type": "string", "enum": ["confirmed", "false-positive", "needs-human"]},
        "notes": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matched", "missed_human_ids", "zephyr_only", "notes"],
      "properties": {
        "matched": {"type": "array", "items": {"$ref": "#/$defs/match"}},
        "missed_human_ids": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
        "zephyr_only": {"type": "array", "items": {"$ref": "#/$defs/zephyrOnly"}},
        "notes": {"$ref": "#/$defs/nonEmpty"}
      }
    }
  }
}
